[worldserver]

#
#    LfgProgression.Enable
#        Description: The Dungeon Finder never sends a player to a dungeon from
#                     an expansion they have not reached. A character's
#                     expansion is its mod-individual-progression tier if IP
#                     is installed and controls the account, otherwise its
#                     level. A random dungeon from a later expansion is swapped
#                     on queue for the group's own (a level 60 who picks
#                     Random Burning Crusade queues for Random Classic), and
#                     specific dungeons from a later expansion are shown as
#                     locked. 0 also turns off the random bot rule below.
#        Default:     1 (enabled)
#

LfgProgression.Enable = 1

#
#    LfgProgression.BotLock
#        Description: Only with mod-playerbots. Random bots follow the
#                     expansion of the real players they are grouped with, not
#                     their own level: at most ClassicMaxLevel when that is
#                     vanilla, at most TbcMaxLevel when it is TBC, no cap when
#                     it is WotLK. With players in different expansions,
#                     BotTier picks which one counts. A player's expansion is
#                     the same as above. Checked when the Dungeon Finder
#                     builds a group; a bot that does not fit stays in the
#                     queue. A random bot is an account in playerbots'
#                     randomBotAccounts; your own altbots and random bots you
#                     invited yourself are left alone. The seasonal bosses are
#                     exempt.
#        Default:     1 (enabled)
#

LfgProgression.BotLock = 1

#
#    LfgProgression.BotTier
#        Description: Only with mod-playerbots. Which expansion random bots
#                     follow when the real players in the group are in
#                     different ones.
#                     0 = the lowest (a vanilla and a TBC player get bots up to
#                         and including 60)
#                     1 = the highest (the same pair gets bots up to and
#                         including 70)
#        Default:     0
#

LfgProgression.BotTier = 0

#
#    LfgProgression.ClassicMaxLevel
#        Description: Highest level in vanilla. A character without an IP tier
#                     is vanilla up to and including this level, and random
#                     bots are capped here when the players are vanilla.
#        Default:     60
#

LfgProgression.ClassicMaxLevel = 60

#
#    LfgProgression.TbcMaxLevel
#        Description: Highest level in TBC. A character without an IP tier is
#                     TBC up to and including this level, WotLK above it, and
#                     random bots are capped here when the players are TBC.
#        Default:     70
#

LfgProgression.TbcMaxLevel = 70
